# PI OS / Mastodon runtime configuration.
# setup.ps1 copies this file to .env.production and fills required values.

# Identity and access
# LOCAL_DOMAIN is the permanent internal identity anchor. Do not make it a real URL.
LOCAL_DOMAIN=pi.invalid

# WEB_DOMAIN is the current public CMX/Mastodon web entrance and may be replaced
# only through change-access-domain.ps1.
WEB_DOMAIN=pi.example.com
STREAMING_API_BASE_URL=wss://pi.example.com

# Temporary Host compatibility during a domain switch. Normally empty.
ALTERNATE_DOMAINS=

# Data services
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=CHANGE_ME_GENERATED_BY_SETUP
REDIS_HOST=redis
REDIS_PORT=6379

# Required secrets — generated once by setup.ps1 and preserved across domain changes.
SECRET_KEY_BASE=
OTP_SECRET=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Private-instance defaults
LIMITED_FEDERATION_MODE=true
AUTHORIZED_FETCH=true
DISALLOW_UNAUTHENTICATED_API_ACCESS=true
SINGLE_USER_MODE=false

# Interface / deployment
DEFAULT_LOCALE=zh-CN
FORCE_DEFAULT_LOCALE=true
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_LEVEL=info
LOG_LEVEL=info
ES_ENABLED=false

# Optional Owner-only PostgreSQL substring search through Mastodon's native
# /api/v2/search UI. Leave blank to fail closed.
CMX_SITE_SEARCH_OWNER_USERNAME=
CMX_GEMINI_DAILY_LIMIT=100

# Optional SMTP. The owner account is created and confirmed from the CLI,
# so SMTP is not required for the first local beta. Configure it before
# relying on password-reset or invitation emails. Use a real sender domain;
# never derive the sender address from LOCAL_DOMAIN=pi.invalid.
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_LOGIN=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=notifications@example.com
# SMTP_ENABLE_STARTTLS=auto
